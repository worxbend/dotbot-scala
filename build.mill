//| mill-version: 1.1.6
package build

import mill.*
import scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule

object Versions:
  val scala = "3.8.4"
  val dotbotScala = "0.1.0"
  val osLib = "0.11.8"
  val upickle = "4.4.3"
  val json5Java = "2.0.0"
  val pprint = "0.9.6"
  val fansi = "0.5.1"
  val ox = "1.0.5"
  val picocli = "4.7.7"
  val snakeyamlEngine = "3.0.1"
  val tomlj = "1.1.1"
  val munit = "1.1.1"

object app extends ScalaModule with ScalafmtModule:
  private def workspaceRoot: os.Path =
    sys.env.get("PWD").map(os.Path(_)).getOrElse(os.Path(sys.props("user.dir")))

  def scalaVersion = Versions.scala

  def mainClass = Some("io.worxbend.dotbot.Main")

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wsafe-init",
  )

  def javacOptions = Seq("--release", "21")

  def forkEnv = Map("DOTBOT_SCALA_VERSION" -> Versions.dotbotScala)

  def mvnDeps = Seq(
    mvn"com.lihaoyi::os-lib:${Versions.osLib}",
    mvn"com.lihaoyi::upickle:${Versions.upickle}",
    mvn"de.marhali:json5-java:${Versions.json5Java}",
    mvn"com.lihaoyi::pprint:${Versions.pprint}",
    mvn"com.lihaoyi::fansi:${Versions.fansi}",
    mvn"com.softwaremill.ox::core:${Versions.ox}",
    mvn"info.picocli:picocli:${Versions.picocli}",
    mvn"org.snakeyaml:snakeyaml-engine:${Versions.snakeyamlEngine}",
    mvn"org.tomlj:tomlj:${Versions.tomlj}",
  )

  def writeAssembly(dest: String = "dist/dotbot-scala.jar") = Task.Command:
    val out = os.Path(dest, workspaceRoot)
    os.makeDir.all(out / os.up)
    os.copy.over(assembly().path, out, createFolders = true)
    println(out)

  object test extends ScalaTests with ScalafmtModule:
    def mvnDeps = Seq(mvn"org.scalameta::munit:${Versions.munit}")

    def testFramework = "munit.Framework"
