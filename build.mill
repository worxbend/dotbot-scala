//| mill-version: 1.1.6
//| mvnDeps: ["com.goyeau::mill-scalafix::0.6.0"]
package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule

object Versions:
  val scala = "3.8.4"
  val dotbotScala = "0.2.3"
  val osLib = "0.11.8"
  val ujson = "4.4.3"
  val fansi = "0.5.1"
  val ox = "1.0.5"
  val picocli = "4.7.7"
  val scalaYaml = "0.3.2"
  val lightbendConfig = "1.4.9"
  val tomlj = "1.1.1"
  val jsoniter = "2.35.3"
  val munit = "1.1.1"
  val munitScalacheck = "1.1.0"

trait DotbotScalaModule extends ScalaModule with ScalafmtModule:
  def scalaVersion = Versions.scala

  def scalacOptions = Seq(
    "-release:21",
    "-Werror",
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wsafe-init",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-source:future",
  )

  def javacOptions = Seq("--release", "21")

object core extends DotbotScalaModule with ScalafixModule

object infra extends DotbotScalaModule:
  override def moduleDeps = Seq(core)

  def mvnDeps = Seq(
    mvn"com.lihaoyi::os-lib:${Versions.osLib}",
    mvn"com.lihaoyi::fansi:${Versions.fansi}",
    mvn"com.softwaremill.ox::core:${Versions.ox}",
    mvn"org.virtuslab::scala-yaml:${Versions.scalaYaml}",
    mvn"com.typesafe:config:${Versions.lightbendConfig}",
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core:${Versions.jsoniter}",
    mvn"org.tomlj:tomlj:${Versions.tomlj}",
  )

object app extends DotbotScalaModule:
  override def moduleDeps = Seq(core, infra)

  def mainClass = Some("io.worxbend.dotbot.Main")

  def forkEnv = Map("DOTBOT_SCALA_VERSION" -> Versions.dotbotScala)

  override def generatedSources = Task:
    super.generatedSources() ++ Seq(buildInfoSources())

  def buildInfoSources = Task:
    val out = Task.dest / "io" / "worxbend" / "dotbot" / "app" / "BuildInfo.scala"
    os.write.over(
      out,
      s"""package io.worxbend.dotbot.app
         |
         |object BuildInfo:
         |  val version: String = "${Versions.dotbotScala}"
         |""".stripMargin,
      createFolders = true,
    )
    PathRef(Task.dest)

  def mvnDeps = Seq(
    mvn"com.lihaoyi::ujson:${Versions.ujson}",
    mvn"info.picocli:picocli:${Versions.picocli}",
  )

  def writeAssembly(dest: String = "dist/dotbot-scala.jar") = Task.Command:
    val out = os.Path(dest, moduleDir / os.up)
    os.makeDir.all(out / os.up)
    os.copy.over(assembly().path, out, createFolders = true)
    println(out)

  object test extends ScalaTests with ScalafmtModule:
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:${Versions.munit}",
      mvn"org.scalameta::munit-scalacheck:${Versions.munitScalacheck}",
    )

    def testFramework = "munit.Framework"
